# .env.android
# The Android app's build (`npm run build:android`, vite --mode android). The app is served from the
# APK, so what the web build finds on its own site is asked of the website it was made from.

# The website whose /api routes (the lyric relay) the app asks (src/utils/system/nativeApp.ts).
VITE_WEB_API_ORIGIN=https://folia-spotify-on-i-phone-jyo4.vercel.app

# Where Spotify's sign-in comes back to: the website's callback page, the same address the website
# registered. The app's web view stops there and takes the answer (src/utils/system/nativeApp.ts).
VITE_SPOTIFY_REDIRECT_URI=https://folia-spotify-on-i-phone-jyo4.vercel.app/spotify-callback.html
